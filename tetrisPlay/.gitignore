data/raw/
data/processed/
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# ---------------------------------------------------------------
